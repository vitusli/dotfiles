{
  "auto_update": false,
  "disable_ai": false,
  "agent": {
    "inline_assistant_use_streaming_tools": true,
    "enabled": true,
    "dock": "right",
    "tool_permissions": {
      "default": "allow"
    },
    "notify_when_agent_waiting": "never",
    "default_model": {
      "provider": "copilot_chat",
      "model": "gpt-5.6-luna",
    },
  },
  "auto_compact": {
    "enabled": true,
    "threshold": "80%",
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 0
    }
  },
  "session": {
    "trust_all_worktrees": true
  },
  "outline_panel": {
    "dock": "left"
  },
  "project_panel": {
    "dock": "left"
  },
  "tab_bar": {
    "show": true
  },
  "title_bar": {
    "show_onboarding_banner": false,
    "show_sign_in": false,
    "show_user_picture": false
  },
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark"
  },
  "vim_mode": true,
  "base_keymap": "VSCode",
  "ui_font_size": 13,
  "buffer_font_size": 13,
  "languages": {
    "Markdown": {
      "soft_wrap": "editor_width"
    }
  },
  "file_scan_exclusions": [
    "**/.venv",
    "**/__pycache__",
    "**/.pytest_cache",
    "**/.mypy_cache",
    "**/.ruff_cache",
    "**/.tox",
    "**/.nox",
    "**/_reference"
  ]
}
