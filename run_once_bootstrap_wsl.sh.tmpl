{{- if eq .chezmoi.os "linux" -}}
#!/bin/bash
set -uo pipefail

if [[ -z "${WSL_DISTRO_NAME:-}" ]]; then
  echo "Skipping WSL bootstrap: linux detected but not WSL."
  exit 0
fi

SOURCE_DIR="{{ .chezmoi.sourceDir }}"
FAILURES=()

run_step() {
  local label="$1"
  local script="$2"

  echo "→ $label"
  if "$script"; then
    echo "✓ $label"
  else
    local rc=$?
    echo "✗ $label (exit $rc)"
    FAILURES+=("$label (exit $rc)")
  fi
  echo
}

run_step "Install apt packages" "$SOURCE_DIR/bootstrap/apps_apt.sh"
run_step "Install Homebrew" "$SOURCE_DIR/bootstrap/install_brew.sh"
run_step "Install apps (brew)" "$SOURCE_DIR/bootstrap/apps_brew.sh"
run_step "Install oh-my-zsh" "$SOURCE_DIR/bootstrap/install_oh_my_zsh.sh"
run_step "Set default shell" "$SOURCE_DIR/bootstrap/wsl_set_default_shell.sh"
run_step "Clone/sync repos" "$SOURCE_DIR/bootstrap/repos.sh"
run_step "Setup LazyVim" "$SOURCE_DIR/bootstrap/setup_lazyvim.sh"

if (( ${#FAILURES[@]} > 0 )); then
  echo "Bootstrap completed with errors:"
  for failure in "${FAILURES[@]}"; do
    echo "  - $failure"
  done
  exit 1
fi

echo "Bootstrap completed successfully."
{{- end -}}
