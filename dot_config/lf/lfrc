# ============================================================================
# LF FILE MANAGER CONFIG (mirrors Marta: ~/Library/Application Support/org.yanex.marta/conf.marco)
# ============================================================================

# Basic Settings
set hidden false
set ignorecase true
set icons true
set incfilter
set watch true

# Marta columns: size + modified
set info size:time
set infotimefmtnew "_2 Jan 15:04"
set infotimefmtold "_2 Jan 2006"

# Show only path in title (no user@host)
set promptfmt "%d"

# Two column view: current dir + preview (no parent dir)
set ratios 1:1
set previewer ~/.config/lf/preview.sh
set cleaner ~/.config/lf/cleaner.sh

# ============================================================================
# KEY BINDINGS (Marta-inspired)
# ============================================================================

# Navigation (hjkl vim-style)
map k up
map j down
map h updir
map <backspace> updir
map <backspace2> updir
map l :setfilter; marta-open
map <enter> :setfilter; open-nvim

# Selection (shift + k/j) - toggle current, then move
map K :toggle; up
map J :toggle; down

# Clear selection, buffer, and filter (single Esc mapping)
map <esc> :unselect; clear; setfilter

# Go to top/bottom
map g top
map G bottom

# Go to path (Marta: \ -> core.go)
map \\ push :cd<space>

# File operations
map r rename
map f push :touch<space>
map n push :mkdir<space>
map <c-x> trash

# Copy/Move (x = cut, c = copy, p = paste)
map x cut
map c copy
map p paste

# Path operations
map y yank-path
map Y yank-dirname

# Toggle hidden files
map H set hidden!

# Reveal in Finder (Marta: cmd+alt+r)
map <c-r> &open -R "$f"

# Git
map L $lazygit

# Bookmarks (Marta: shift+` / shift+p / shift+a / shift+d / shift+c)
map ~ cd ~
map P :cd ~/Library/CloudStorage/OneDrive-WandelbotsGmbH/nvidia_omniverse/projects; filter
map A :cd ~/Library/CloudStorage/OneDrive-WandelbotsGmbH/Asset-Library; filter
map D :cd ~/dev; filter
map C :cd ~/codespace; filter

# Open current directory in VS Code
map V &open -a "Visual Studio Code" "$PWD"

# Disable default 'd' (cut) as requested
map d :echo "Cut is disabled"

# Filter (classic lf filter)
map / filter

# Enter in filter mode: accept filter and open the selection; elsewhere plain Enter
cmap <enter> &{{
    if [ "$lf_mode" = filter ] && [ -n "$f" ]; then
        lf -remote "send $id :cmd-enter; setfilter; open-nvim"
    elif [ "$lf_mode" = filter ]; then
        lf -remote "send $id :cmd-enter; setfilter"
    else
        lf -remote "send $id cmd-enter"
    fi
}}

# Toggle executable permission (Shift+X)
map X toggle-executable

# ============================================================================
# COMMANDS
# ============================================================================

# Like Marta: apps/bundles launch instead of being entered as folders
cmd marta-open &{{
    case "$f" in
        *.app|*.bundle|*.pages|*.numbers|*.key|*.rtfd|*.photoslibrary|*.xcodeproj|*.xcworkspace)
            open "$f" ;;
        *)
            lf -remote "send $id open" ;;
    esac
}}

cmd open-nvim ${{
    if [ -d "$f" ]; then
        lf -remote "send $id open"
    else
        nvim "$f"
    fi
}}

# Like Marta core.trash: confirm, then move to macOS Trash
cmd trash %{{
    # $fx is empty right after startup; `trash ""` would trash the cwd
    [ -n "$fx" ] || exit 0
    lf -remote "send $id echo Move $(printf '%s
' "$fx" | wc -l | tr -d ' ') item(s) to Trash? [y/N]"
    read -r ans
    [ "$ans" = "y" ] || { lf -remote "send $id echo"; exit 0; }
    printf '%s
' "$fx" | while IFS= read -r p; do [ -e "$p" ] && trash "$p"; done
    lf -remote "send $id :unselect; reload; echo"
}}

cmd touch %{{
    name="$*"
    [ -n "$name" ] || exit 0
    touch -- "$name"
    lf -remote "send $id :reload; select \"$name\""
}}

cmd mkdir %{{
    name="$*"
    [ -n "$name" ] || exit 0
    mkdir -p -- "$name"
    lf -remote "send $id :reload; select \"$name\""
}}

# Yank path to clipboard - macOS
cmd yank-path &{{
    printf "%s" "$f" | pbcopy
    lf -remote "send $id echo Copied: $f"
}}

# Yank directory path to clipboard - macOS
cmd yank-dirname &{{
    printf "%s" "$PWD" | pbcopy
    lf -remote "send $id echo Copied: $PWD"
}}

# Toggle executable permission
cmd toggle-executable &{{
    if [ -x "$f" ]; then
        chmod -x "$f"
        lf -remote "send $id echo Removed executable: $f"
    else
        chmod +x "$f"
        lf -remote "send $id echo Made executable: $f"
    fi
    lf -remote "send $id reload"
}}
