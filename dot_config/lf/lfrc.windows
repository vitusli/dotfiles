# ============================================================================
# LF CONFIG FOR WINDOWS (over SSH) - Marta-like, see AGENTS.md
# Copied manually to %APPDATA%\lf\lfrc, not deployed by chezmoi.
# Shell commands must stay single-line (multi-line cmds are unreliable on Windows).
# ============================================================================

set shell powershell
set shellopts -NoProfile
set shellflag -Command

# Basic Settings
set hidden false
set ignorecase true
set icons true
set incfilter
set watch true

# Marta columns: size + modified
set info size:time
set infotimefmtnew "_2 Jan 15:04"
set infotimefmtold "_2 Jan 2006"

set promptfmt "%d"
set ratios 1:1

# ============================================================================
# KEY BINDINGS (same as macOS lfrc)
# ============================================================================

map k up
map j down
map h updir
map l :setfilter; open
map <enter> :setfilter; open

map K :toggle; up
map J :toggle; down

map <esc> :unselect; clear; setfilter

map g top
map G bottom

# Go to path (Marta: \ -> core.go)
map \\ push :cd<space>

map r rename
map f push :touch<space>
map n push :mkdir<space>
# No recycle bin over SSH: permanent delete with lf's own confirmation
map <c-x> delete

map x cut
map c copy
map p paste

# Copies to the local clipboard via OSC 52
map y yank-path
map Y yank-dirname

map H set hidden!

map L $lazygit

# Bookmarks
map ~ cd ~
map W :cd ~/Downloads; filter

map d :echo "Cut is disabled"
map / filter
# Enter in filter mode: accept filter and open the selection; elsewhere plain Enter
cmap <enter> &if ($env:lf_mode -eq 'filter' -and $env:f) { lf -remote ('send ' + $env:id + ' :cmd-enter; setfilter; open') } elseif ($env:lf_mode -eq 'filter') { lf -remote ('send ' + $env:id + ' :cmd-enter; setfilter') } else { lf -remote ('send ' + $env:id + ' cmd-enter') }

# ============================================================================
# COMMANDS
# ============================================================================

cmd open $if (Get-Command nvim -ErrorAction SilentlyContinue) { nvim $env:f } else { Get-Content -LiteralPath $env:f | more; [void][Console]::ReadKey($true) }

cmd touch &New-Item -ItemType File -Path
cmd mkdir &New-Item -ItemType Directory -Path

cmd yank-path &$b = [Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes($env:f)); lf -remote ('send ' + $env:id + ' tty-write ''' + [char]27 + ']52;c;' + $b + [char]7 + ''''); lf -remote ('send ' + $env:id + ' echo ''Copied: ' + $env:f + '''')
cmd yank-dirname &$b = [Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes($PWD.Path)); lf -remote ('send ' + $env:id + ' tty-write ''' + [char]27 + ']52;c;' + $b + [char]7 + ''''); lf -remote ('send ' + $env:id + ' echo ''Copied: ' + $PWD.Path + '''')
